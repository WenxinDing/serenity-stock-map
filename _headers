/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, must-revalidate

/market-data.json
  Cache-Control: no-cache, must-revalidate

/translations.json
  Cache-Control: no-cache, must-revalidate

/archive.json
  Cache-Control: public, max-age=300, must-revalidate

/archive-ui.json
  Cache-Control: public, max-age=300, must-revalidate
